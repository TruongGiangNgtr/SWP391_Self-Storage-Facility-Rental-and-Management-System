<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- These integration fixtures target SQL Server (dbo/sys.tables, SqlClient, T-SQL),
       while the current application and migrations use PostgreSQL/Npgsql. Keep the
       source for porting/reference, but do not compile it into the active test suite. -->
  <ItemGroup>
    <Compile Remove="PaymentSqlTestSupport.cs" />
    <Compile Remove="PaymentPersistenceTests.cs" />
    <Compile Remove="PaymentResultSqlTests.cs" />
    <Compile Remove="PaymentServiceSqlTests.cs" />
    <Compile Remove="PayOsPersistenceTests.cs" />
    <Compile Remove="RealSqlServerAuthenticationTests.cs" />
    <Compile Remove="RealSqlServerBaselineTests.cs" />
    <Compile Remove="ReservationCancellationSqlTests.cs" />
    <Compile Remove="SqlScriptTestDatabase.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Frms.Api\Frms.Api.csproj" />
    <ProjectReference Include="..\..\Frms.DataAccess\Frms.DataAccess.csproj" />
  </ItemGroup>

</Project>
