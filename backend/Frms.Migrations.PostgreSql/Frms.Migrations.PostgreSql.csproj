<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Frms.DataAccess/Persistence/Entities/Entities.cs" Link="Shared/Entities.cs" />
    <Compile Include="../Frms.DataAccess/Persistence/SeedIds.cs" Link="Shared/SeedIds.cs" />
    <Compile Include="../Frms.DataAccess/Persistence/PostgreSqlStringSearch.cs" Link="Shared/PostgreSqlStringSearch.cs" />
    <EmbeddedResource Include="../sql/postgresql/*.sql" LogicalName="Frms.DataAccess.PostgreSql.%(Filename)%(Extension)" />
    <!-- Pg011 demo routine is intentionally under /demo, outside the normal wildcard. -->
    <EmbeddedResource Include="../sql/postgresql/demo/CheckInVisitDemo.sql" LogicalName="Frms.DataAccess.PostgreSql.CheckInVisitDemo.sql" />
  </ItemGroup>
</Project>
